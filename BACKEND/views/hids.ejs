<script>

    const HOST_ID = "PC-001";

    /*
    =========================================================
    Dashboard state
    =========================================================
    */

    const expandedState = {
        processTableBody: false,
        securityTableBody: false,
        fileTableBody: false
    };


    /*
    =========================================================
    Helper: Escape HTML
    =========================================================
    */

    function escapeHtml(value) {

        if (value === null || value === undefined) {
            return "-";
        }

        return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }


    /*
    =========================================================
    Helper: Format timestamp
    =========================================================
    */

    function formatTime(timestamp) {

        if (!timestamp) {
            return "-";
        }

        const date = new Date(timestamp);

        if (isNaN(date.getTime())) {
            return timestamp;
        }

        return date.toLocaleString();
    }


    /*
    =========================================================
    Helper: Event badge
    =========================================================
    */

    function eventBadge(eventType) {

        const event = String(eventType || "").toUpperCase();

        if (
            event.includes("SUCCESS") ||
            event.includes("CREATED")
        ) {
            return `<span class="badge badge-green">${escapeHtml(event)}</span>`;
        }

        if (
            event.includes("FAILED") ||
            event.includes("DELETED")
        ) {
            return `<span class="badge badge-red">${escapeHtml(event)}</span>`;
        }

        if (
            event.includes("MODIFIED") ||
            event.includes("LOGOFF")
        ) {
            return `<span class="badge badge-blue">${escapeHtml(event)}</span>`;
        }

        if (
            event.includes("RENAMED") ||
            event.includes("USER_LOGOFF")
        ) {
            return `<span class="badge badge-yellow">${escapeHtml(event)}</span>`;
        }

        return `<span class="badge badge-gray">${escapeHtml(event || "UNKNOWN")}</span>`;
    }


    /*
    =========================================================
    Helper: Safe API request
    =========================================================
    */

    async function fetchJson(url) {

        const response = await fetch(url, {
            cache: "no-store"
        });

        if (!response.ok) {
            throw new Error(
                `HTTP ${response.status} - ${response.statusText}`
            );
        }

        return await response.json();
    }


    /*
    =========================================================
    HOST DATA
    =========================================================
    */

    async function updateHost() {

        try {

            const data = await fetchJson(
                `/api/host/${HOST_ID}`
            );

            if (!data.success || !data.host) {
                throw new Error("Host data not available");
            }

            const host = data.host;

            document.getElementById("hostname").textContent =
                host.hostname || HOST_ID;

            document.getElementById("hostId").textContent =
                host.hostId || HOST_ID;

            document.getElementById("navHostId").textContent =
                host.hostId || HOST_ID;

            document.getElementById("os").textContent =
                host.os || "Unknown";

            document.getElementById("cpu").textContent =
                Number(host.cpu || 0).toFixed(1);

            document.getElementById("ram").textContent =
                Number(host.ram || 0).toFixed(1);

            document.getElementById("disk").textContent =
                Number(host.disk || 0).toFixed(1);

            document.getElementById("processCount").textContent =
                host.processCount ?? 0;

            document.getElementById("lastSeen").textContent =
                formatTime(host.lastSeen);


            /*
            =================================================
            Online / Offline
            =================================================
            */

            let online = false;

            if (host.lastSeen) {

                const lastSeenTime =
                    new Date(host.lastSeen).getTime();

                const now = Date.now();

                online =
                    now - lastSeenTime <= 15000;
            }


            const statusText =
                document.getElementById("navStatusText");

            const statusDot =
                document.getElementById("navStatusDot");

            if (online) {

                statusText.textContent = "ONLINE";

                statusText.className =
                    "text-[10px] font-semibold text-green-400";

                statusDot.className =
                    "status-dot online-dot";

            } else {

                statusText.textContent = "OFFLINE";

                statusText.className =
                    "text-[10px] font-semibold text-red-400";

                statusDot.className =
                    "status-dot offline-dot";
            }


        } catch (error) {

            console.error("Host API Error:", error);

        }

    }


    /*
    =========================================================
    PROCESS TELEMETRY
    =========================================================
    */

    async function updateProcesses() {

        const table =
            document.getElementById("processTableBody");

        try {

            const data = await fetchJson(
                `/api/processes/${HOST_ID}`
            );

            const processes = Array.isArray(data.processes)
                ? data.processes
                : [];

            document.getElementById("processCountLabel").textContent =
                `${data.count ?? processes.length} records`;


            if (processes.length === 0) {

                table.innerHTML = `
                    <tr>
                        <td colspan="6" class="empty">
                            No process telemetry available
                        </td>
                    </tr>
                `;

                return;
            }


            table.innerHTML = processes.map((process, index) => {

                const status =
                    process.status ||
                    process.eventType ||
                    (process.terminated ? "TERMINATED" : "RUNNING");

                const statusUpper =
                    String(status).toUpperCase();

                let statusHtml;

                if (
                    statusUpper.includes("TERMIN") ||
                    statusUpper.includes("STOP")
                ) {

                    statusHtml =
                        `<span class="badge badge-red">${escapeHtml(statusUpper)}</span>`;

                } else {

                    statusHtml =
                        `<span class="badge badge-green">${escapeHtml(statusUpper || "RUNNING")}</span>`;
                }


                return `
                    <tr class="${index >= 5 ? "hidden-row" : ""}">

                        <td class="font-semibold text-gray-700">
                            ${escapeHtml(process.pid)}
                        </td>

                        <td class="font-medium text-gray-800">
                            ${escapeHtml(
                                process.processName ||
                                process.name ||
                                "-"
                            )}
                        </td>

                        <td
                            class="max-w-[320px] truncate"
                            title="${escapeHtml(
                                process.executablePath ||
                                process.path ||
                                "-"
                            )}"
                        >
                            ${escapeHtml(
                                process.executablePath ||
                                process.path ||
                                "-"
                            )}
                        </td>

                        <td>
                            ${escapeHtml(
                                process.username ||
                                process.user ||
                                "-"
                            )}
                        </td>

                        <td>
                            ${statusHtml}
                        </td>

                        <td>
                            ${formatTime(
                                process.timestamp ||
                                process.createdAt ||
                                process.updatedAt
                            )}
                        </td>

                    </tr>
                `;

            }).join("");


            updateToggleButton(
                "processTableBody",
                "processToggle"
            );


        } catch (error) {

            console.error("Process API Error:", error);

            table.innerHTML = `
                <tr>
                    <td colspan="6" class="error-row">
                        Unable to load process telemetry
                    </td>
                </tr>
            `;
        }

    }


    /*
    =========================================================
    SECURITY EVENTS
    =========================================================
    */

    async function updateSecurityEvents() {

        const table =
            document.getElementById("securityTableBody");

        try {

            const data = await fetchJson(
                `/api/security-events/${HOST_ID}`
            );

            const events = Array.isArray(data.events)
                ? data.events
                : [];

            document.getElementById("securityCountLabel").textContent =
                `${data.count ?? events.length} events`;


            if (events.length === 0) {

                table.innerHTML = `
                    <tr>
                        <td colspan="9" class="empty">
                            No security events available
                        </td>
                    </tr>
                `;

                return;
            }


            table.innerHTML = events.map((event, index) => {

                return `
                    <tr class="${index >= 5 ? "hidden-row" : ""}">

                        <td>
                            ${eventBadge(event.eventType)}
                        </td>

                        <td class="font-semibold">
                            ${escapeHtml(event.eventId)}
                        </td>

                        <td class="font-medium">
                            ${escapeHtml(event.username)}
                        </td>

                        <td>
                            ${escapeHtml(event.logonType)}
                        </td>

                        <td>
                            ${escapeHtml(event.ipAddress)}
                        </td>

                        <td>
                            ${escapeHtml(event.workstationName)}
                        </td>

                        <td>
                            ${escapeHtml(
                                event.authenticationPackageName
                            )}
                        </td>

                        <td>
                            ${escapeHtml(event.recordId)}
                        </td>

                        <td>
                            ${formatTime(event.timestamp)}
                        </td>

                    </tr>
                `;

            }).join("");


            updateToggleButton(
                "securityTableBody",
                "securityToggle"
            );


        } catch (error) {

            console.error("Security API Error:", error);

            table.innerHTML = `
                <tr>
                    <td colspan="9" class="error-row">
                        Unable to load security events
                    </td>
                </tr>
            `;
        }

    }


    /*
    =========================================================
    FILE EVENTS
    =========================================================
    */

    async function updateFileEvents() {

        const table =
