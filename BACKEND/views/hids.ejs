    /*
    =========================================================
    VIEW MORE / VIEW LESS
    =========================================================
    */

    function toggleRows(tableId, buttonId) {

        const table =
            document.getElementById(tableId);

        const button =
            document.getElementById(buttonId);

        const isExpanded =
            expandedState[tableId];

        expandedState[tableId] =
            !isExpanded;

        const rows =
            table.querySelectorAll("tr");

        rows.forEach((row, index) => {

            if (index >= 5) {

                if (expandedState[tableId]) {

                    row.classList.remove("hidden-row");

                } else {

                    row.classList.add("hidden-row");
                }
            }
        });


        updateToggleButton(tableId, buttonId);
    }


    /*
    =========================================================
    UPDATE BUTTON TEXT
    =========================================================
    */

    function updateToggleButton(tableId, buttonId) {

        const table =
            document.getElementById(tableId);

        const button =
            document.getElementById(buttonId);

        if (!table || !button) {
            return;
        }


        const rows =
            Array.from(
                table.querySelectorAll("tr")
            );


        /*
        If there are 5 or fewer actual rows,
        hide the button.
        */

        if (rows.length <= 5) {

            button.classList.add("hidden");

            return;
        }


        button.classList.remove("hidden");


        if (expandedState[tableId]) {

            button.textContent =
                "View Less ↑";

        } else {

            button.textContent =
                "View More ↓";
        }

    }


    /*
    =========================================================
    DASHBOARD UPDATE TIME
    =========================================================
    */

    function updateDashboardTime() {

        document.getElementById(
            "dashboardUpdate"
        ).textContent =
            new Date().toLocaleTimeString();

    }


    /*
    =========================================================
    UPDATE EVERYTHING
    =========================================================
    */

    async function updateDashboard() {

        updateDashboardTime();

        await Promise.allSettled([
            updateHost(),
            updateProcesses(),
            updateSecurityEvents(),
            updateFileEvents()
        ]);

    }


    /*
    =========================================================
    INITIAL LOAD
    =========================================================
    */

    updateDashboard();


    /*
    =========================================================
    AUTO REFRESH
    =========================================================
    */

    setInterval(
        updateDashboard,
        5000
    );

</script>

