<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AI-HIDS Security Dashboard</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: "Inter", sans-serif;
            background: #f5f7fa;
            color: #172033;
        }

        .card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
        }

        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background: #f8fafc;
            color: #64748b;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            white-space: nowrap;
            padding: 10px 12px;
            border-bottom: 1px solid #e5e7eb;
            text-align: left;
        }

        td {
            padding: 10px 12px;
            font-size: 12px;
            color: #334155;
            border-bottom: 1px solid #f1f5f9;
            white-space: nowrap;
        }

        tr:last-child td {
            border-bottom: none;
        }

        tbody tr:hover {
            background: #f8fafc;
        }

        .metric-card {
            transition: all 0.2s ease;
        }

        .metric-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 16px rgba(15, 23, 42, 0.07);
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
        }

        .online-dot {
            background: #22c55e;
            box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.12);
        }

        .offline-dot {
            background: #ef4444;
            box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.12);
        }

        .section-title {
            font-size: 15px;
            font-weight: 700;
            color: #172033;
        }

        .section-subtitle {
            font-size: 11px;
            color: #94a3b8;
            margin-top: 2px;
        }

        .view-btn {
            border: 1px solid #dbe2ea;
            background: white;
            color: #334155;
            padding: 7px 12px;
            border-radius: 8px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .view-btn:hover {
            background: #f1f5f9;
            border-color: #cbd5e1;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            padding: 4px 8px;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 600;
            white-space: nowrap;
        }

        .badge-green {
            color: #15803d;
            background: #dcfce7;
        }

        .badge-red {
            color: #b91c1c;
            background: #fee2e2;
        }

        .badge-blue {
            color: #1d4ed8;
            background: #dbeafe;
        }

        .badge-yellow {
            color: #a16207;
            background: #fef3c7;
        }

        .badge-gray {
            color: #475569;
            background: #f1f5f9;
        }

        .scroll-area {
            overflow-x: auto;
        }

        .hidden-row {
            display: none;
        }

        .loading {
            color: #94a3b8;
            text-align: center;
            padding: 22px !important;
        }

        .empty {
            color: #94a3b8;
            text-align: center;
            padding: 22px !important;
        }

        .error-row {
            color: #dc2626;
            background: #fef2f2;
            text-align: center;
            padding: 16px !important;
        }
    </style>
</head>

